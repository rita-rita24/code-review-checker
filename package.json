{
  "name": "code-review-checker",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "test:browser": "node --test tests/browser/*.test.cjs",
    "build:parser": "node scripts/embed-parser.cjs",
    "check:parser": "node scripts/embed-parser.cjs --check"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "acorn-loose": "8.5.2",
    "esbuild": "0.28.2",
    "java-parser": "3.0.1",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "lodash": "4.18.1",
    "lodash-es": "4.18.1"
  }
}
